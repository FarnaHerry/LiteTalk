prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: opusfile
Description: High-level Opus decoding library - LiteTalk third_party
Version: 0.12
Requires.private: ogg >= 1.3 opus >= 1.0.1
Conflicts:
Libs: -L${libdir} -lopusfile
Libs.private:
Cflags: -I${includedir}/opus
