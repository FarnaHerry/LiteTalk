# 轻音 LiteTalk — 服务端环境变量示例
# 部署位置：/etc/litetalk.env（chmod 600，systemd EnvironmentFile 加载）
# 带「必改」的项上线前务必替换；其余保持默认即可。

# ---- 监听 ----
LITETALK_ADDR=:8077              # HTTP/WS 监听（Nginx 反代到 127.0.0.1 即可，不必对外）

# ---- SFU（媒体转发）----
LITETALK_SFU_UDP=7845            # ICE-Lite UDP mux 端口（安全组放行该端口 UDP）
LITETALK_SFU_IP=公网IP           # 必改：对外宣告 IP（公网/弹性 IP）
LITETALK_SFU_MAX=10              # 语音房间人数上限

# ---- TURN（NAT 穿透）----
LITETALK_TURN_SECRET=CHANGE_ME   # 必改：随机长串，与 coturn static-auth-secret 一致
LITETALK_TURN_URLS=turn:litetalk.example.com:3478   # 必改：你的域名/IP
LITETALK_STUN_URLS=stun:litetalk.example.com:3478   # 必改：你的域名/IP

# ---- 存储 ----
LITETALK_MYSQL_DSN=litetalk:CHANGE_ME@tcp(127.0.0.1:3306)/litetalk?parseTime=true   # 必改：数据库密码；留空则内存模式（仅测试）
LITETALK_REDIS_ADDR=127.0.0.1:6379                   # 留空自动降级内存（仅测试）
# LITETALK_MIGRATIONS_DIR=migrations                 # 迁移目录，默认相对路径即可

# ---- 账号安全 ----
LITETALK_JWT_SECRET=CHANGE_ME    # 必改：随机长串（如 openssl rand -hex 32）
LITETALK_AUTH_MODE=full          # full=验证码流程（公网推荐）；simple=免验证码（仅私域）

# ---- 发信（full 模式发验证码用，三选一；全不配走 Console 日志）----
# 通道 1：自有发码平台（Webhook）
# LITETALK_MAILER_WEBHOOK=https://your-provider.example.com/send-code
# LITETALK_MAILER_WEBHOOK_TOKEN=CHANGE_ME
# 通道 2：SMTP（465 隐式 TLS / 587 STARTTLS 自适应）
# LITETALK_SMTP_HOST=smtp.example.com
# LITETALK_SMTP_PORT=587
# LITETALK_SMTP_USER=noreply@example.com
# LITETALK_SMTP_PASS=CHANGE_ME
# LITETALK_SMTP_FROM=轻音 LiteTalk <noreply@example.com>

# ---- 开发调试 ----
# LITETALK_DEV_AUTH=1            # 仅开发：允许 dev-<用户名> 免签名令牌；生产严禁开启
